---
/** Full project index with client-side filtering by industry. */
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import { projects } from '../../data/projects';

const FIRST_PROJECTS = [
  'kmace-towing',
  'bed-bugs-begone',
  'american-southern-exterminating',
  'evergreen-lawn-pest',
  'heat-bed-bugs-landing',
  'indy-trojan-roofing',
  'top-bed-bug-pros',
  'atlanta-bed-bug-experts',
  'midwest-bed-bug',
  'heat-tech-pest-control',
  'heat-rx',
  'chapman-plumbing',
  'quarry-view-building-group',
  'smile-well-dental',
  'wpdllc',
];

const orderedProjects = [...projects].sort((a, b) => {
  const aIndex = FIRST_PROJECTS.indexOf(a.slug);
  const bIndex = FIRST_PROJECTS.indexOf(b.slug);

  if (aIndex !== -1 && bIndex !== -1) return aIndex - bIndex;
  if (aIndex !== -1) return -1;
  if (bIndex !== -1) return 1;
  return 0;
});


/** Every distinct tag across all projects, alphabetised, for the filter bar. */
const allCategories = [...new Set(projects.map((project) => project.category))].sort((a, b) =>
  a.localeCompare(b),
);
---

<Layout
  title="Projects"
  description="Website, SEO, and automation projects by Dave Oyangorin: WordPress and Shopify websites, technical and local SEO, and GoHighLevel CRM automation."
>
  <div class="container-page py-16 sm:py-20">
    <header class="max-w-2xl" data-reveal>
      <p class="mb-3 font-mono text-sm text-[var(--accent)] uppercase">
        Portfolio
      </p>
      <h1 class="text-3xl font-medium sm:text-4xl">Projects</h1>
      <p class="mt-5 text-lg text-[var(--text-muted)]">
        {projects.length} client projects: websites, SEO, funnels, and CRM automation. Filter by the
        industry each one serves.
      </p>
    </header>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-project-grid>
      {
        orderedProjects.map((project, index) => (
          <div
            class="flex"
            data-reveal
            data-project-category={project.category}
            style={`--reveal-delay: ${(index % 3) * 80}ms`}
          >
            <ProjectCard project={project} eager={index < 3} maxTags={4} />
          </div>
        ))
      }
    </div>

    <p class="mt-12 hidden text-center text-[var(--text-muted)]" data-empty-state>
      No projects match that filter.
    </p>
  </div>
</Layout>


